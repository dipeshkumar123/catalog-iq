# LLM Configuration
LLM_PROVIDER=mock
LLM_CONCURRENCY=5
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0.1

# Set LLM_PROVIDER=groq and fill GROQ_API_KEY to use real Groq
# GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
# With GROQ_API_KEY and GEMINI_API_KEY set, Groq is primary and Gemini is the transient-error fallback.
# Set LLM_FALLBACK_PROVIDER=none to disable fallback; set LLM_COMPLEX_PROVIDER=gemini for long listings.
# LLM_FALLBACK_PROVIDER=none
# LLM_COMPLEX_PROVIDER=gemini
LLM_BATCH_SIZE=10
LLM_BATCH_WINDOW_MS=20
LLM_REVIEW_CONFIDENCE_THRESHOLD=0.85

# Optional Redis integration: Streams queue, shared dedup cache, and distributed RPM/TPM token bucket.
# REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_STREAM=catalogiq:jobs
REDIS_QUEUE_GROUP=catalogiq-workers
REDIS_QUEUE_CLAIM_IDLE_MS=300000
REDIS_CACHE_TTL_SECONDS=86400
LLM_RATE_LIMIT_RPM=0
LLM_RATE_LIMIT_TPM=0

# Server & Database Settings
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=catalog_iq.db
LOG_LEVEL=INFO
